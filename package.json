{
  "name": "clearmail",
  "productName": "ClearMail",
  "version": "0.3.0",
  "description": "A read-only summary of your inbox: sorts your email into Needs you, Worth knowing and Noise, and shortens it. It can't send, delete, move or change anything.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --mac --universal --publish never"
  },
  "build": {
    "appId": "com.clearmail.app",
    "productName": "ClearMail",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "package.json",
      "build-config.json"
    ],
    "publish": null,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": "-",
      "notarize": false
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "writeUpdateInfo": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    }
  },
  "dependencies": {
    "imapflow": "2.2.1",
    "mailparser": "3.9.33"
  },
  "devDependencies": {
    "electron": "43.7.7",
    "electron-builder": "26.17.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
