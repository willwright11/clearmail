{
  "name": "clearmail",
  "productName": "ClearMail",
  "version": "0.1.0",
  "description": "Reads your email like a chat app: strips the waffle, highlights what matters.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --mac"
  },
  "build": {
    "appId": "com.clearmail.app",
    "productName": "ClearMail",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "package.json"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "imapflow": "2.2.1",
    "mailparser": "3.9.33",
    "nodemailer": "10.0.13"
  },
  "devDependencies": {
    "electron": "43.7.7",
    "electron-builder": "26.17.0"
  }
}
